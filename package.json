{
  "name": "retrospect-cli",
  "version": "1.0.1",
  "description": "Evolution-aware code search for git repositories: find current code by its former names, and ask questions grounded in code and history.",
  "main": "src/index.js",
  "bin": {
    "rtro": "bin/rtro.js",
    "retrospect": "bin/rtro.js"
  },
  "files": [
    "bin/",
    "src/",
    "!src/evaluation/benchmarks/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand",
    "evaluate": "node src/evaluation/evaluationRunner.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K-NagaCharan/RETROSPECT.git"
  },
  "bugs": {
    "url": "https://github.com/K-NagaCharan/RETROSPECT/issues"
  },
  "homepage": "https://github.com/K-NagaCharan/RETROSPECT#readme",
  "keywords": [
    "code-search",
    "git",
    "git-history",
    "refactoring",
    "rename",
    "retrieval",
    "tree-sitter",
    "llm",
    "cli"
  ],
  "author": "K-NagaCharan",
  "license": "MIT",
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
