{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrospect.org/schemas/phase_c/authored_query.schema.json",
  "title": "Phase C Author-Produced Query Schema",
  "description": "Defines the output structure created by an independent, blinded query author based exclusively on a sanitized Context Card.",
  "type": "object",
  "required": [
    "query_id",
    "card_id",
    "benchmark_id",
    "partition",
    "query_text",
    "intent_category",
    "author_metadata"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "pattern": "^QRY-EXP-(DEV|TEST)-[0-9]{2}$"
    },
    "card_id": {
      "type": "string",
      "pattern": "^CARD-EXP-(DEV|TEST)-[0-9]{2}$"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^EXP-(DEV|TEST)-[0-9]{2}$"
    },
    "partition": {
      "type": "string",
      "enum": ["DEVELOPMENT", "HELD_OUT_TEST"]
    },
    "query_text": {
      "type": "string",
      "minLength": 15,
      "maxLength": 500,
      "description": "Natural language developer query searching for the code responsible for the task."
    },
    "intent_category": {
      "type": "string",
      "enum": [
        "BUG_FIX",
        "FEATURE_ADDITION",
        "REFACTORING",
        "SECURITY_HARDENING",
        "API_EVOLUTION"
      ]
    },
    "author_metadata": {
      "type": "object",
      "required": [
        "author_id",
        "author_experience_level",
        "authorship_timestamp",
        "blinded_attestation",
        "external_search_used"
      ],
      "properties": {
        "author_id": {
          "type": "string",
          "description": "Pseudonymous identifier of the independent query author."
        },
        "author_experience_level": {
          "type": "string",
          "enum": ["JUNIOR_DEV", "MID_DEV", "SENIOR_DEV", "MAINTAINER"]
        },
        "authorship_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "blinded_attestation": {
          "type": "boolean",
          "description": "True if the author certifies they did not consult repository git history, source files, or commit logs while authoring."
        },
        "external_search_used": {
          "type": "boolean",
          "description": "Indicates whether the author used general web search (e.g. MDN or RFC specifications) for terminology."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
